#pragma once

// Copy this file to include/secrets.h in your PlatformIO project.
// Keep include/secrets.h out of Git; never commit real Wi-Fi/broker credentials.

#define COLDGUARDIAN_DEVICE_ID "tracker-001"

#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Use an address reachable FROM THE ESP32, not 127.0.0.1.
// If Mosquitto is on the development laptop, LAN/WSL port forwarding must be configured.
#define MQTT_BROKER_HOST "192.168.1.100"
#define MQTT_BROKER_PORT 1883

// Leave username empty only if the broker intentionally permits anonymous access.
// Do not expose an anonymous broker to a LAN.
#define MQTT_USERNAME ""
#define MQTT_PASSWORD ""
